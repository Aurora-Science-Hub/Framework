<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>AuroraScienceHub.Framework.AspNetCore</AssemblyName>
    <PackageId>AuroraScienceHub.Framework.AspNetCore</PackageId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- MSB3277: on net10.0 the ASP.NET Core 10 reference pack has Microsoft.Extensions.* 10.0.0.0, while the packages are intentionally 11.x (a higher assembly version wins at runtime). -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Package info">
    <PackageDescription>
      ASP.NET Core extensions for composition, diagnostics, problem details (RFC 7807), security utilities, and routing enhancements.
    </PackageDescription>
    <PackageTags>aspnetcore;aspnet;web;api;problem-details;rfc7807;routing;security;middleware;healthchecks</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Composition\Composition.csproj" />
    <ProjectReference Include="..\Diagnostics\Diagnostics.csproj" />
    <ProjectReference Include="..\Entities\Entities.csproj" />
    <ProjectReference Include="..\Utilities\Utilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="Mediator.Abstractions" />
  </ItemGroup>

</Project>
