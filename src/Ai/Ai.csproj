<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>AuroraScienceHub.Framework.Ai</AssemblyName>
    <PackageId>AuroraScienceHub.Framework.Ai</PackageId>
    <!--
      Experimental APIs of the AI libraries are allowed in this project only, each listed here with the API that needs
      it and why (see AGENTS.md, "Never suppress the compiler"):
      - SCME0001: ChatCompletionOptions.Patch (JsonPatch), to send the legacy max_tokens that DeepSeek honors instead
        of max_completion_tokens (AiChatOptionsFactory)
    -->
    <NoWarn>$(NoWarn);SCME0001</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Package info">
    <PackageDescription>
      AI services built on Microsoft Agent Framework: a stateless assistant with optional MCP tools, conversation
      compaction, and DeepL professional translation.
    </PackageDescription>
    <PackageTags>ai;artificial-intelligence;agent-framework;openai;mcp;deepl;translation;machine-translation;llm</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DeepL.net" />
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="ModelContextProtocol.Core" />
    <PackageReference Include="OpenAI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Http\Http.csproj" />
    <ProjectReference Include="..\Json\Json.csproj" />
    <ProjectReference Include="..\Utilities\Utilities.csproj" />
  </ItemGroup>

</Project>
